{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**,documents/**"
    },
    "api/*.js": {
      "includeFiles": "data/**,documents/**"
    }
  }
}
