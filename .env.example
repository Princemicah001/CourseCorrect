# Course Real M-Pesa Configuration (No Shortcode / Direct to Personal Phone)
PORT=3000

# Choose active payment provider: payhero | tinypesa | intasend | daraja
PAYMENT_PROVIDER=payhero

# Personal Safaricom phone number to receive student payments directly:
RECEIVING_PHONE=0707865597

# 1. PayHero Kenya (Recommended for personal phone numbers - payhero.co.ke)
# Create account at payhero.co.ke, link your personal M-Pesa number & get credentials:
PAYHERO_API_KEY=your_payhero_username_here
PAYHERO_API_SECRET=your_payhero_api_secret_here
PAYHERO_CHANNEL_ID=11662
PAYHERO_ACCOUNT_ID=11180
# Optional: pre-computed Basic auth header (base64 of API_KEY:API_SECRET)
PAYHERO_BASIC_AUTH=

# 2. TinyPesa (tinypesa.com - direct personal M-Pesa push)
TINYPESA_API_KEY=

# 3. IntaSend (intasend.com)
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=

# 4. Safaricom Daraja (Only if you have an official Business Till/Paybill)
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_ENVIRONMENT=sandbox
