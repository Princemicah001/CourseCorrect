# PostgreSQL (Neon or another hosted PostgreSQL provider)
DATABASE_URL=
# Optional: set to disable only for local PostgreSQL without TLS
PGSSLMODE=

# Cloudinary credentials (keep these server-side; never expose in browser code)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial administrator account (set before first admin sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
