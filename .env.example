# PostgreSQL (Neon or another hosted PostgreSQL provider)
DATABASE_URL=

# Cloudinary credentials (keep these server-side; never expose in browser code)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap. Use a long random password; never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session signing / encryption secret: generate with: openssl rand -base64 48
SESSION_SECRET=
